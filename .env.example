# Required — replace with your own key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Optional — avoids HF rate limits on cold-start model download
HF_TOKEN=

# DO NOT set SPACE_ID here. If set, chroma path becomes /tmp/vector_db
# and your 19k-chunk DB will vanish between container restarts.